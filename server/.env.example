PORT=5000
NODE_ENV=development

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agriconnect

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Weather API (OpenWeatherMap)
OPENWEATHER_API_KEY=

# AI Layer (Anthropic Claude API)
ANTHROPIC_API_KEY=

# SMS / voice alerts (Twilio). Leave blank to simulate alerts (logged, not sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Country code added to 10-digit numbers
SMS_DEFAULT_COUNTRY_CODE=91

# Who can load/remove sample demo data from the UI: public | admin | off
# (default: public in development, admin when NODE_ENV=production)
DEMO_TOGGLE=
